# Try On Studio — Backend API Base URL (no trailing slash)
VITE_API_BASE_URL=https://clothesai3d.runasp.net

# Optional override if Commerce/Orders/Loyalty endpoints are hosted separately from VITE_API_BASE_URL
# VITE_COMMERCE_API_BASE_URL=https://clothesai3d.runasp.net

# Server-side ONLY secrets for Vercel Serverless Stripe Helper (/api/payments/stripe)
# Configure in .env.local or Vercel Environment Variables — NEVER prefix secrets with VITE_
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# USD_TO_EGP_RATE=50

# Legacy / Obsolete (Fashion Assistant is now hosted on the authoritative ASP.NET backend at /api/assistant/*):
# GEMINI_API_KEY=legacy_unused_in_active_frontend
# GEMINI_MODEL=gemini-3-flash-preview
